# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# Neon connection string. Take the POOLED one from the Neon dashboard
# (the host contains "-pooler") and keep ?sslmode=require on the end.
# Example shape — not a real credential:
# postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Signing key for JWTs. Any long random string; changing it logs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Render sets PORT itself — leave this unset there, it is only for local runs.
PORT=3000

NODE_ENV=development

# Only used when DATABASE_URL is empty (local Postgres without a URL).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=azh_chat
# DB_USER=postgres
# DB_PASSWORD=
